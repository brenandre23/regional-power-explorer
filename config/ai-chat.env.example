# Browser-visible configuration only. NEVER put a provider secret in VITE_*.
# Leave VITE_AI_GATEWAY_BASE_URL blank for BYO-key POC mode.
VITE_AI_PROVIDER=anthropic
VITE_AI_GATEWAY_BASE_URL=
VITE_AI_ALLOW_USER_KEY=true
# Optional comma-separated exact package model ids approved for this deployment; the
# first one the package knows is the default. Unset: claude-opus-5,claude-sonnet-5.
VITE_AI_ALLOWED_MODELS=
